# Virtual env / build junk
.venv/
venv/
build/
dist/
__pycache__/
*.pyc
*.pyo
*.spec

# Local runtime / single-instance lock
DesktopPet.lock

# NEVER commit or ship the user's live config / save data / personal media.
# Only packaging/config.json (blank template) is tracked.
config.json
!packaging/config.json
Data/
data/
save/
saves/
userdata/
user_data/

# Common local folders where pet images / private pics may sit
pet_images/
user_images/
pics/
private/
personal/

# Optional 箱庭島 user art drops (naming in hakoniwa/README.md); keep README only
hakoniwa/assets/user/*.png
hakoniwa/assets/user/*.jpg
hakoniwa/assets/user/*.jpeg
hakoniwa/assets/user/*.webp
!hakoniwa/assets/user/README.md

# Release staging folder (built by build.bat) — rebuild from packaging template only
上載版/
upload/
release_upload/

# Built binary at repo root
DesktopPet.exe
